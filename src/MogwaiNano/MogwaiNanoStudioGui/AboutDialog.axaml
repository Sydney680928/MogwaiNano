<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MogwaiNanoStudioGui.AboutDialog"
        Title="About MOGWAI NANO Studio"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="20" Spacing="16">
        <Image Source="avares://MogwaiNanoStudioGui/Assets/mogwai-mascot.png"
               Width="120"
               HorizontalAlignment="Center"/>
        <StackPanel Spacing="2">
            <TextBlock x:Name="StudioVersionText" FontWeight="Bold"/>
            <TextBlock x:Name="StudioCopyrightText"/>
        </StackPanel>
        <TextBlock x:Name="EngineInfoText" TextWrapping="Wrap"/>
        <Button Content="OK" Click="OnOkClick" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
